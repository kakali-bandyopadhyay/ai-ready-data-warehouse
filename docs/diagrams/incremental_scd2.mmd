flowchart TD
  IN["Generated source rows"] --> SEED["Initial dbt seed"]
  SEED --> BUILD1["dbt build: staging then baseline snapshot"]
  BUILD1 --> SNAP["Company timestamp snapshot"]
  SNAP --> HIST["Company history: prior rows close, current row stays open"]
  BUILD1 --> CHANGE["Promote generated company change"]
  CHANGE --> SEED2["Reload seeds"]
  SEED2 --> BUILD2["dbt build: second snapshot version"]
  BUILD2 --> VERIFY["Verify two versions and one current row"]
  VERIFY --> FACT["Build facts and compare repeat-build fingerprints"]
  BUILD2 --> LATE["90-day ingestion-time overlap reprocesses late transactions"]
  FACT --> PASS["Idempotency check"]
